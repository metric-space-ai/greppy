{
  "schema_version": "greppy.agent-coding-v3.adapter-config.1",
  "repository_id": "cpp-opencv",
  "repository_url": "https://github.com/opencv/opencv",
  "primary_language": "cpp",
  "toolchain_profile": "cpp-cmake",
  "test_globs": ["modules/**/test/**", "modules/**/perf/**", "**/*test.cpp", "**/*test.cc"],
  "ignore_globs": ["build/**", "**/build/**", "3rdparty/**", "**/generated/**"],
  "source_extensions": [".cc", ".cpp", ".c", ".h", ".hpp"],
  "setup_commands": [["cmake", "-S", ".", "-B", "build", "-G", "Ninja", "-DBUILD_TESTS=ON", "-DBUILD_PERF_TESTS=OFF", "-DBUILD_EXAMPLES=OFF", "-DCMAKE_BUILD_TYPE=Release"], ["cmake", "--build", "build", "-j2"]],
  "post_patch_commands": [["cmake", "--build", "build", "-j2"]],
  "label_task_classes": {"bug": "reported_bugfix", "feature": "feature_implementation"},
  "timeout_seconds": 3600
}
