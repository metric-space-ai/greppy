{
  "schema_version": "greppy.agent-coding-v3.adapter-config.1",
  "repository_id": "python-scrapy",
  "repository_url": "https://github.com/scrapy/scrapy",
  "primary_language": "python",
  "toolchain_profile": "python-pip",
  "test_globs": ["tests/**", "**/test_*.py", "**/*_test.py"],
  "ignore_globs": ["docs/**", "**/vendor/**", "**/generated/**", "**/*.lock"],
  "source_extensions": [".py"],
  "f2p_command": ["python3", "-m", "pytest", "-q", "{test_paths}"],
  "p2p_command": ["python3", "-m", "pytest", "-q"],
  "label_task_classes": {"bug": "reported_bugfix", "enhancement": "feature_implementation"},
  "setup_commands": [],
  "timeout_seconds": 1800
}
