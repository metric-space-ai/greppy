{
  "schema_version": "greppy.agent-coding-v3.adapter-config.1",
  "repository_id": "ruby-rails",
  "repository_url": "https://github.com/rails/rails",
  "primary_language": "ruby",
  "toolchain_profile": "ruby-bundler",
  "test_globs": ["**/test/**", "test/**", "**/*_test.rb"],
  "ignore_globs": ["vendor/**", "**/vendor/**", "tmp/**", "Gemfile.lock"],
  "source_extensions": [".rb"],
  "f2p_command": ["bundle", "exec", "rake", "test"],
  "p2p_command": ["bundle", "exec", "rake", "test"],
  "label_task_classes": {"bug": "reported_bugfix", "feature": "feature_implementation"},
  "setup_commands": [],
  "timeout_seconds": 3600
}
